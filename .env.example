# Knowledge Base RAG System - Environment Variables

# LLM Provider Configuration
# Available providers: gemini, deepseek, zhipu, qianwen, doubao
# Set LLM_PROVIDER to switch between different LLM services
LLM_PROVIDER=deepseek

# Google Gemini API Key (required if LLM_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API Key (required if LLM_PROVIDER=deepseek)
# Free tier available, sign up at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ZhiPu GLM API Key (required if LLM_PROVIDER=zhipu)
# Free tier available, sign up at: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# Aliyun Qianwen API Key (required if LLM_PROVIDER=qianwen)
# Free tier available, sign up at: https://dashscope.console.aliyun.com/
QIANWEN_API_KEY=your_qianwen_api_key_here

# ByteDance Doubao API Key (required if LLM_PROVIDER=doubao)
# Free tier available, sign up at: https://www.volcengine.com/product/doubao
DOUBAO_API_KEY=your_doubao_api_key_here

# Optional: Database path (default: my_local_database)
# CHROMA_DB_PATH=./my_local_database